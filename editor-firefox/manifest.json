{
  "manifest_version": 2,
  "name": "seetoprice editor",
  "version": "1.0",
  "description": "Редактирует данные SeeToPrice через его API",
  
  "browser_specific_settings": {
    "gecko": {
      "id": "{51c0848e-9d21-4587-aaaa-c14eacccff9a}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  
  "permissions": [
    "storage"
  ],
  
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "SeeToPrice Editor",
    "default_icon": {
      "64": "icon48.png"
    }
  },
  
  "icons": {
    "64": "icon48.png"
  }
}